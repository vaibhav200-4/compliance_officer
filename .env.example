# Copy this file to .env and supply local values.

# ============================================================
# REQUIRED: Pinecone Configuration
# ============================================================
GOOGLE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=complianceiq
PINECONE_NAMESPACE=company-policy

# ============================================================
# OPTIONAL: Embedding Configuration
# ============================================================
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# ============================================================
# LLM ENDPOINT CONFIGURATION
# ============================================================

# OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=

# NVIDIA NIM (recommended for production)
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_NIM_API_KEYS=
# Optional override; defaults to NVIDIA's OpenAI-compatible endpoint.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# ============================================================
# LLM EXECUTION CONFIGURATION
# ============================================================

# Select which LLM provider to use (optional)
# If not set, all configured providers are used.
# Set to "nvidia" for NVIDIA NIM only, or "openrouter" for OpenRouter only.
LLM_PROVIDER=nvidia

# HTTP request timeout in seconds (default: 30)
LLM_REQUEST_TIMEOUT=30

# Maximum retry attempts for transient LLM failures (default: 3)
LLM_MAX_RETRIES=3

# ============================================================
# ORCHESTRATION CONFIGURATION
# ============================================================

# Article-level concurrency: number of articles processed in parallel (default: 5)
ARTICLE_WORKERS=5

# Group-level concurrency: number of groups within each article (default: 1)
# Recommended: 1 for bounded parallelism with article-level concurrency
GROUP_WORKERS=1

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
APP_NAME=ComplianceIQ
APP_VERSION=0.1.0
APP_DEBUG=false

# Legacy/unused keys (kept for backwards compatibility)
MISTRAL_API_KEY=
LLM_MODEL=
